# SPA fallback for React Router / Single Page App
# Place this file in the `public/` folder so Vite copies it to `dist/` on build.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Do not rewrite existing files or directories
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Rewrite all other requests to index.html
  RewriteRule . /index.html [L]
</IfModule>

# Ensure index.html is used as directory index
DirectoryIndex index.html
